# Токен вашего Telegram-бота (получите у @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Интервал проверки новых вакансий (в минутах)
CHECK_INTERVAL_MINUTES=15

# Включённые источники вакансий (через запятую)
# Примеры: hh | superjob | hh,superjob
ENABLED_SOURCES=hh

# Поисковый запрос для hh.ru (можно менять под себя)
HH_SEARCH_QUERY=менеджер маркетплейсов ozon wildberries

# User-Agent для запросов к hh.ru
HH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36

# Режим получения вакансий:
#   direct — бот сам делает HTTP-запросы к hh.ru (для деплоя на VPS)
#   ssh    — запросы идут через SSH на зарубежный VPS (для локального запуска из РФ)
HH_FETCH_MODE=direct

# --- SSH-доступ к зарубежному VPS (нужно только при HH_FETCH_MODE=ssh) ---
HH_SSH_HOST=
HH_SSH_USER=root
HH_SSH_KEY_PATH=~/.ssh/id_ed25519_vps

# Secret key приложения SuperJob (X-Api-App-Id) — запасной источник.
# Получить бесплатно: https://api.superjob.ru/register/
SUPERJOB_API_KEY=
